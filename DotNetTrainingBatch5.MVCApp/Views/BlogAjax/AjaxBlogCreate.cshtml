@{
    ViewData["Title"] = "Ajax Blog Create";
}

<div class="mb-3">
    <label for="txtTitle" class="form-label">Blog Title</label>
    <input type="text" class="form-control" id="txtTitle" name="Title">
</div>
<div class="mb-3">
    <label for="txtAuthor" class="form-label">Blog Author</label>
    <input type="text" class="form-control" id="txtAuthor" name="Author">
</div>
<div class="mb-3">
    <label for="txtContent" class="form-label">Blog Content</label>
    <textarea class="form-control" id="txtContent" name="Description" rows="3"></textarea>
</div>
<div class="">
    <button type="button" class="btn btn-success" id="btnSave">Save</button>
    <button type="button" class="btn btn-secondary" id="btnCancel">Cancel</button>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#btnSave').click(function() {

                let ititle = $('#txtTitle').val();
                let iauthor = $('#txtAuthor').val();
                let idescription = $('#txtContent').val();

                $.ajax({
                    url: '/BlogAjax/ASave',
                    type: 'POST',
                    data: {
                        Title: ititle,
                        Author: iauthor,
                        Description: idescription
                    },
                    success: function(response) {
                        alert('Blog created successfully!');
                        // Optionally, you can redirect or clear the form here
                        window.location.href = '/BlogAjax/List'; // Redirect to the list page
                    },
                    error: function(xhr, status, error) {
                        alert('Error creating blog: ' + xhr.responseText);
                    }
                });
            });
            $('#btnCancel').click(function() {
                window.location.href = '/BlogAjax/List'; // Redirect to the list page
            });
        });
    </script>
}
