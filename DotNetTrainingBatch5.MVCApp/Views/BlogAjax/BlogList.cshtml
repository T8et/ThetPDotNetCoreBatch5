<a href="BlogAjax/Create" class="btn btn-primary mt-3">Create Blog</a>

<table class=" table table-responsive">
    <thead>
        <tr>
            <th>No.</th>
            <th>Blog Title</th>
            <th>Blog Content</th>
            <th>Blog Author</th>
            <th>Controls</th>
        </tr>
    </thead>
    <tbody>
        
    </tbody>
</table>

@section Scripts {
    <script>
        $(document).ready(function(){
            loadData();
        })

        function loadData(){
            $.ajax({
                url: '/BlogAjax/List',
                type: 'GET',
                success: function(data) {
                    $('tbody').empty();
                    for (let i = 0; i < data.length; i++)
                    {
                        let blog = data[i];
                        let row = `
                            <tr>
                                <td>${i + 1}</td>
                                <td>${blog.BlogTitle}</td>
                                <td>${blog.BlogContent}</td>
                                <td>${blog.BlogAuthor}</td>
                                <td>
                                    <a href="/BlogAjax/Edit/${blog.BlogId}" class="btn btn-primary">Edit</a>
                                    <button type="button" data-id="${blog.BlogId}" class="btn btn-danger btn-delete">Delete</button>
                                </td>
                            </tr>
                        `;
                        $('tbody').append(row);
                    }
                    deleteBlog();
                },
                error: function() {
                    alert('Error retrieving blogs.');
                }
            });
        }

        function deleteBlog() {
            $(".btn-delete").click(function() {
                const did = $(this).data("id");
                $.ajax({
                    url: '/BlogAjax/Delete/' + did,
                    type: 'POST',
                    data: { id: did },
                    success: function() {
                        alert('Blog deleted successfully!');
                        loadData();
                    },
                    error: function() {
                        alert('Error deleting blog.');
                    }
                });
            });
        }
    </script>
}